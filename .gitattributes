# 统一换行，避免 Windows/macOS 协作时整文件 diff
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 启动.bat 用 `type` 打这些提示文案。cmd 的 type 在纯 LF 文件上可能输出
# 成台阶状（每行不回到行首），所以强制 CRLF 出库。
tools/msg/*.txt text eol=crlf

# 二进制：不要让 git 试图做文本 diff 或换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.m4a binary
*.ogg binary
*.mp3 binary
*.wav binary
*.zip binary
*.ttf binary
*.woff2 binary
